{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "rules": {
    "consistent-type-specifier-style": "off",
    "default": "off",
    "export": "off",
    "exports-last": "off",
    "extensions": "off",
    "first": "error",
    "group-exports": "off",
    "max-dependencies": "off",
    "named": "off",
    "namespace": "off",
    "newline-after-import": "off",
    "no-absolute-path": "error",
    "no-amd": "off",
    "no-anonymous-default-export": "error",
    "no-commonjs": "off",
    "no-cycle": "off",
    "no-default-export": "off",
    "no-duplicates": "error",
    "no-dynamic-require": "error",
    "no-empty-named-blocks": "off",
    "no-mutable-exports": "off",
    "no-named-as-default": "off",
    "no-named-as-default-member": "off",
    "no-named-default": "off",
    "no-named-export": "off",
    "no-namespace": "off",
    "no-nodejs-modules": "off",
    "no-relative-parent-imports": "off",
    "no-self-import": "off",
    "no-unassigned-import": "off",
    "no-webpack-loader-syntax": "off",
    "prefer-default-export": "off",
    "unambiguous": "off",
  },
}
