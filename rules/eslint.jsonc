{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "rules": {
    "accessor-pairs": "off",
    "array-callback-return": [
      "error",
      {
        "allowImplicit": true,
      },
    ],
    "arrow-body-style": "off",
    "block-scoped-var": "error",
    "capitalized-comments": "off",
    "class-methods-use-this": "off",
    "complexity": "off",
    "constructor-super": "error",
    "curly": ["error", "multi-line"],
    "default-case": "error",
    "default-case-last": "error",
    "default-param-last": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore",
      },
    ],
    "for-direction": "error",
    "func-name-matching": "off",
    "func-names": ["error", "as-needed"],
    "func-style": [
      "error",
      "expression",
      {
        "allowArrowFunctions": true,
      },
    ],
    "getter-return": "error",
    "grouped-accessor-pairs": "error",
    "guard-for-in": "error",
    "id-length": "off",
    "id-match": "off",
    "init-declarations": "off",
    "logical-assignment-operators": [
      "error",
      "always",
      {
        "enforceForIfStatements": true,
      },
    ],
    "max-classes-per-file": "off",
    "max-depth": ["error", 4],
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-nested-callbacks": "off",
    "max-params": "off",
    "max-statements": "off",
    "new-cap": "off",
    "no-alert": "error",
    "no-array-constructor": "error",
    "no-async-promise-executor": "error",
    "no-await-in-loop": "error",
    "no-bitwise": "error",
    "no-caller": "error",
    "no-case-declarations": "off",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-console": "warn",
    "no-const-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-constructor-return": "error",
    "no-continue": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-div-regex": "off",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-duplicate-imports": "off",
    "no-else-return": [
      "error",
      {
        "allowElseIf": false,
      },
    ],
    "no-empty": "off",
    "no-empty-character-class": "error",
    "no-empty-function": [
      "error",
      {
        "allow": ["arrowFunctions"],
      },
    ],
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-eq-null": "off",
    "no-eval": "error",
    "no-ex-assign": "error",
    "no-extend-native": "error",
    "no-extra-bind": "error",
    "no-extra-boolean-cast": "error",
    "no-extra-label": "error",
    "no-fallthrough": "off",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-implicit-coercion": "error",
    "no-implicit-globals": "off",
    "no-implied-eval": "error",
    "no-import-assign": "error",
    "no-inline-comments": "off",
    "no-inner-declarations": "off",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-iterator": "error",
    "no-label-var": "error",
    "no-labels": "error",
    "no-lone-blocks": "error",
    "no-lonely-if": "error",
    "no-loop-func": "error",
    "no-loss-of-precision": "error",
    "no-magic-numbers": "off",
    "no-misleading-character-class": "error",
    "no-multi-assign": "error",
    "no-multi-str": "error",
    "no-negated-condition": "off",
    "no-nested-ternary": "off",
    "no-new": "error",
    "no-new-func": "error",
    "no-new-native-nonconstructor": "error",
    "no-new-wrappers": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-object-constructor": "error",
    "no-param-reassign": [
      "error",
      {
        "props": false,
      },
    ],
    "no-plusplus": "error",
    "no-promise-executor-return": "error",
    "no-proto": "error",
    "no-prototype-builtins": "off",
    "no-redeclare": "error",
    "no-regex-spaces": "off",
    "no-restricted-exports": [
      "error",
      {
        "restrictedNamedExports": ["default", "then"],
      },
    ],
    "no-restricted-globals": [
      "off",
      {
        "restrictedGlobals": {
          "addEventListener": {
            "name": "addEventListener",
            "message": "Use window.addEventListener instead",
          },
          "blur": {
            "name": "blur",
            "message": "Use window.blur instead",
          },
          "close": {
            "name": "close",
            "message": "Use window.close instead",
          },
          "closed": {
            "name": "closed",
            "message": "Use window.closed instead",
          },
          "confirm": {
            "name": "confirm",
            "message": "Use window.confirminstead",
          },
          "defaultStatus": {
            "name": "defaultStatus",
            "message": "Use window.defaultStatus instead",
          },
          "defaultstatus": {
            "name": "defaultstatus",
            "message": "Use window.defaultstatus instead",
          },
          "event": {
            "name": "event",
            "message": "Use window.event instead",
          },
          "external": {
            "name": "external",
            "message": "Use window.external instead",
          },
          "find": {
            "name": "find",
            "message": "Use window.find instead",
          },
          "focus": {
            "name": "focus",
            "message": "Use window.focus instead",
          },
          "frameElement": {
            "name": "frameElement",
            "message": "Use window.frameElement instead",
          },
          "frames": {
            "name": "frames",
            "message": "Use window.frames instead",
          },
          "history": {
            "name": "history",
            "message": "Use window.history instead",
          },
          "innerHeight": {
            "name": "innerHeight",
            "message": "Use window.innerHeight instead",
          },
          "innerWidth": {
            "name": "innerWidth",
            "message": "Use window.innerWidth instead",
          },
          "length": {
            "name": "length",
            "message": "Use window.length instead",
          },
          "location": {
            "name": "location",
            "message": "Use window.location instead",
          },
          "locationbar": {
            "name": "locationbar",
            "message": "Use window.locationbar instead",
          },
          "menubar": {
            "name": "menubar",
            "message": "Use window.menubar instead",
          },
          "moveBy": {
            "name": "moveBy",
            "message": "Use window.moveBy instead",
          },
          "moveTo": {
            "name": "moveTo",
            "message": "Use window.moveTo instead",
          },
          "name": {
            "name": "name",
            "message": "Use window.name instead",
          },
          "onblur": {
            "name": "onblur",
            "message": "Use window.onblur instead",
          },
          "onerror": {
            "name": "onerror",
            "message": "Use window.onerror instead",
          },
          "onfocus": {
            "name": "onfocus",
            "message": "Use window.onfocus instead",
          },
          "onload": {
            "name": "onload",
            "message": "Use window.onload instead",
          },
          "onresize": {
            "name": "onresize",
            "message": "Use window.onresize instead",
          },
          "onunload": {
            "name": "onunload",
            "message": "Use window.onunload instead",
          },
          "open": {
            "name": "open",
            "message": "Use window.open instead",
          },
          "opener": {
            "name": "opener",
            "message": "Use window.opener instead",
          },
          "opera": {
            "name": "opera",
            "message": "Use window.opera instead",
          },
          "outerHeight": {
            "name": "outerHeight",
            "message": "Use window.outerHeight instead",
          },
          "outerWidth": {
            "name": "outerWidth",
            "message": "Use window.outerWidth instead",
          },
          "pageXOffset": {
            "name": "pageXOffset",
            "message": "Use window.pageXOffset instead",
          },
          "pageYOffset": {
            "name": "pageYOffset",
            "message": "Use window.pageYOffset instead",
          },
          "parent": {
            "name": "parent",
            "message": "Use window.parent instead",
          },
          "print": {
            "name": "print",
            "message": "Use window.print instead",
          },
          "removeEventListener": {
            "name": "removeEventListener",
            "message": "Use window.removeEventListener instead",
          },
          "resizeBy": {
            "name": "resizeBy",
            "message": "Use window.resizeBy instead",
          },
          "resizeTo": {
            "name": "resizeTo",
            "message": "Use window.resizeTo instead",
          },
          "screen": {
            "name": "screen",
            "message": "Use window.screen instead",
          },
          "screenLeft": {
            "name": "screenLeft",
            "message": "Use window.screenLeft instead",
          },
          "screenTop": {
            "name": "screenTop",
            "message": "Use window.screenTop instead",
          },
          "screenX": {
            "name": "screenX",
            "message": "Use window.screenX instead",
          },
          "screenY": {
            "name": "screenY",
            "message": "Use window.screenY instead",
          },
          "scroll": {
            "name": "scroll",
            "message": "Use window.scroll instead",
          },
          "scrollbars": {
            "name": "scrollbars",
            "message": "Use window.scrollbars instead",
          },
          "scrollBy": {
            "name": "scrollBy",
            "message": "Use window.scrollBy instead",
          },
          "scrollTo": {
            "name": "scrollTo",
            "message": "Use window.scrollTo instead",
          },
          "scrollX": {
            "name": "scrollX",
            "message": "Use window.scrollX instead",
          },
          "scrollY": {
            "name": "scrollY",
            "message": "Use window.scrollY instead",
          },
          "status": {
            "name": "status",
            "message": "Use window.status instead",
          },
          "statusbar": {
            "name": "statusbar",
            "message": "Use window.statusbar instead",
          },
          "stop": {
            "name": "stop",
            "message": "Use window.stop instead",
          },
          "toolbar": {
            "name": "toolbar",
            "message": "Use window.toolbar instead",
          },
          "top": {
            "name": "top",
            "message": "Use window.top instead",
          },
        },
      },
    ],
    "no-restricted-imports": "off",
    "no-restricted-properties": [
      "error",
      {
        "object": "arguments",
        "property": "callee",
        "message": "arguments.callee is deprecated",
      },
      {
        "object": "global",
        "property": "isFinite",
        "message": "Please use Number.isFinite instead",
      },
      {
        "object": "self",
        "property": "isFinite",
        "message": "Please use Number.isFinite instead",
      },
      {
        "object": "window",
        "property": "isFinite",
        "message": "Please use Number.isFinite instead",
      },
      {
        "object": "global",
        "property": "isNaN",
        "message": "Please use Number.isNaN instead",
      },
      {
        "object": "self",
        "property": "isNaN",
        "message": "Please use Number.isNaN instead",
      },
      {
        "object": "window",
        "property": "isNaN",
        "message": "Please use Number.isNaN instead",
      },
      {
        "property": "__defineGetter__",
        "message": "Please use Object.defineProperty instead.",
      },
      {
        "property": "__defineSetter__",
        "message": "Please use Object.defineProperty instead.",
      },
    ],
    "no-return-assign": ["error", "always"],
    "no-script-url": "error",
    "no-self-assign": "error",
    "no-self-compare": "error",
    "no-sequences": "error",
    "no-setter-return": "error",
    "no-shadow": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-template-curly-in-string": "error",
    "no-ternary": "off",
    "no-this-before-super": "error",
    "no-throw-literal": "error",
    "no-unassigned-vars": "error",
    "no-undef": "off",
    "no-undefined": "off",
    "no-underscore-dangle": "off",
    "no-unexpected-multiline": "off",
    "no-unmodified-loop-condition": "off",
    "no-unneeded-ternary": [
      "error",
      {
        "defaultAssignment": false,
      },
    ],
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-expressions": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-unused-vars": "error",
    "no-use-before-define": "error",
    "no-useless-assignment": "off",
    "no-useless-backreference": "error",
    "no-useless-call": "error",
    "no-useless-catch": "error",
    "no-useless-computed-key": "error",
    "no-useless-concat": "error",
    "no-useless-constructor": "error",
    "no-useless-escape": "error",
    "no-useless-rename": "error",
    "no-useless-return": "error",
    "no-var": "error",
    "no-void": "error",
    "no-warning-comments": "off",
    "no-with": "error",
    "object-shorthand": "error",
    "operator-assignment": "error",
    "prefer-arrow-callback": "off",
    "prefer-const": [
      "error",
      {
        "ignoreReadBeforeAssign": true,
      },
    ],
    "prefer-destructuring": "error",
    "prefer-exponentiation-operator": "error",
    "prefer-numeric-literals": "error",
    "prefer-object-has-own": "error",
    "prefer-object-spread": "error",
    "prefer-promise-reject-errors": "error",
    "prefer-regex-literals": [
      "error",
      {
        "disallowRedundantWrapping": true,
      },
    ],
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "prefer-template": "error",
    "preserve-caught-error": "off",
    "radix": "error",
    "require-await": "error",
    "require-unicode-regexp": "off",
    "require-yield": "error",
    "sort-imports": [
      "error",
      {
        "allowSeparatedGroups": true,
        "ignoreCase": true,
        "ignoreDeclarationSort": true,
        "ignoreMemberSort": false,
        "memberSyntaxSortOrder": ["none", "all", "multiple", "single"],
      },
    ],
    "sort-keys": "error",
    "sort-vars": "off",
    "symbol-description": "error",
    "unicode-bom": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "vars-on-top": "error",
    "yoda": "error",
  },
}
