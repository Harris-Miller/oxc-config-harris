{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": ["**/*.test.*", "**/*spec.*"],
      "plugins": ["jest"],
      "rules": {
        "consistent-test-it": "error",
        "expect-expect": "error",
        "max-expects": "off",
        "max-nested-describe": "off",
        "no-alias-methods": "error",
        "no-commented-out-tests": "error",
        "no-conditional-expect": "error",
        "no-conditional-in-test": "off",
        "no-confusing-set-timeout": "off",
        "no-deprecated-functions": "error",
        "no-disabled-tests": "error",
        "no-done-callback": "error",
        "no-duplicate-hooks": "error",
        "no-export": "error",
        "no-focused-tests": "error",
        "no-hooks": "off",
        "no-identical-title": "error",
        "no-interpolation-in-snapshots": "error",
        "no-jasmine-globals": "error",
        "no-large-snapshots": "error",
        "no-mocks-import": "error",
        "no-restricted-jest-methods": [
          "error",
          {
            "restrictedJestMethods": {
              "clearAllMocks": "`clearMocks` has been enabled for tests, so is already being called automatically by Jest`",
            },
          },
        ],
        "no-restricted-matchers": "off",
        "no-standalone-expect": "error",
        "no-test-prefixes": "error",
        "no-test-return-statement": "error",
        "no-unneeded-async-expect-function": "off",
        "no-untyped-mock-factory": "off",
        "padding-around-after-all-blocks": "off",
        "padding-around-test-blocks": "off",
        "prefer-called-with": "off",
        "prefer-comparison-matcher": "error",
        "prefer-each": "off",
        "prefer-ending-with-an-expect": "off",
        "prefer-equality-matcher": "error",
        "prefer-expect-assertions": "off",
        "prefer-expect-resolves": "error",
        "prefer-hooks-in-order": "off",
        "prefer-hooks-on-top": "error",
        "prefer-importing-jest-globals": "off",
        "prefer-jest-mocked": "off",
        "prefer-lowercase-title": "off",
        "prefer-mock-promise-shorthand": "off",
        "prefer-mock-return-shorthand": "off",
        "prefer-snapshot-hint": "off",
        "prefer-spy-on": "error",
        "prefer-strict-equal": "off",
        "prefer-to-be": "error",
        "prefer-to-contain": "error",
        "prefer-to-have-been-called": "off",
        "prefer-to-have-been-called-times": "off",
        "prefer-to-have-length": "error",
        "prefer-todo": "error",
        "require-hook": "off",
        "require-to-throw-message": "off",
        "require-top-level-describe": "error",
        "valid-describe-callback": "error",
        "valid-expect": "error",
        "valid-expect-in-promise": "error",
        "valid-title": "error",
      },
    },
  ],
}
