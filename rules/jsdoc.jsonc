{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["jsdoc"],
  "rules": {
    "check-access": "error",
    "check-property-names": "error",
    "check-tag-names": ["error", { "typed": true }],
    "empty-tags": "error",
    "implements-on-classes": "error",
    "no-defaults": "error",
    "require-param": "error",
    "require-param-description": "error",
    "require-param-name": "error",
    "require-param-type": "off",
    "require-property": "error",
    "require-property-description": "error",
    "require-property-name": "error",
    "require-property-type": "off",
    "require-returns": "error",
    "require-returns-description": "error",
    "require-returns-type": "off",
    "require-throws-description": "off",
    "require-throws-type": "off",
    "require-yields": "error",
    "require-yields-type": "off",
  },
}
