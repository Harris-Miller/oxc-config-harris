{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["promise"],
  "rules": {
    "always-return": [
      "off",
      {
        "ignoreAssignmentVariable": ["globalThis"],
        "ignoreLastCallback": false
      }
    ],
    "avoid-new": "off",
    "catch-or-return": [
      "off",
      {
        "allowFinally": false,
        "allowThen": false,
        "terminationMethod": ["catch"]
      }
    ],
    "no-callback-in-promise": [
      "off",
      {
        "callbacks": ["callback", "cb", "done", "next"],
        "exceptions": [],
        "timeoutsErr": false
      }
    ],
    "no-multiple-resolved": "off",
    "no-nesting": "off",
    "no-new-statics": "off",
    "no-promise-in-callback": [
      "off",
      {
        "exemptDeclarations": false
      }
    ],
    "no-return-in-finally": "off",
    "no-return-wrap": [
      "off",
      {
        "allowReject": false
      }
    ],
    "param-names": "off",
    "prefer-await-to-callbacks": "off",
    "prefer-await-to-then": [
      "off",
      {
        "strict": false
      }
    ],
    "prefer-catch": "off",
    "spec-only": "off",
    "valid-params": "off"
  }
}
