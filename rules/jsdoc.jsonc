{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["jsdoc"],
  "rules": {
    "check-access": "off",
    "check-property-names": "off",
    "check-tag-names": "off",
    "empty-tags": "off",
    "implements-on-classes": "off",
    "no-defaults": "off",
    "require-param": "off",
    "require-param-description": "off",
    "require-param-name": "off",
    "require-param-type": "off",
    "require-property": "off",
    "require-property-description": "off",
    "require-property-name": "off",
    "require-property-type": "off",
    "require-returns": "off",
    "require-returns-description": "off",
    "require-returns-type": "off",
    "require-throws-description": "off",
    "require-throws-type": "off",
    "require-yields": "off",
    "require-yields-type": "off",
  },
}
