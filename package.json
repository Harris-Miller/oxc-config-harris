{
  "name": "oxlint-config-harris",
  "version": "0.1.0",
  "private": true,
  "description": "Harris' Personal Shared Oxlint and Oxfmt configs monorepo",
  "keywords": [
    "config",
    "formatter",
    "harris",
    "javascript",
    "linter",
    "oxfmt",
    "oxlint",
    "react",
    "styleguide",
    "typescript"
  ],
  "license": "MIT",
  "author": "Harris Miller <harrismillerconsulting@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/Harris-Miller/oxc-config-harris.git"
  },
  "files": [
    "configs",
    "rules"
  ],
  "type": "module",
  "exports": {
    "./configs/*.jsonc": "./configs/*.jsonc",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.66.0",
    "oxlint-tsgolint": ">=0.23.0"
  },
  "packageManager": "pnpm@10.30.1"
}
