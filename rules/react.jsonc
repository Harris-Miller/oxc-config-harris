{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": ["**/*.jsx", "**/*.tsx"],
      "plugins": ["react"],
      "rules": {
        "button-has-type": "error",
        "checked-requires-onchange-or-readonly": "error",
        "display-name": "off",
        "exhaustive-deps": "error",
        "forbid-component-props": "off",
        "forbid-dom-props": "off",
        "forbid-elements": "off",
        "forward-ref-uses-ref": "off",
        "hook-use-state": "error",
        "iframe-missing-sandbox": "error",
        "jsx-boolean-value": ["error", "never", { "always": [] }],
        "jsx-curly-brace-presence": "error",
        "jsx-filename-extension": "off",
        "jsx-fragments": ["error", "syntax"],
        "jsx-handler-names": "off",
        "jsx-key": "error",
        "jsx-max-depth": "off",
        "jsx-no-comment-textnodes": "error",
        "jsx-no-constructed-context-values": "error",
        "jsx-no-duplicate-props": "error",
        "jsx-no-script-url": "error",
        "jsx-no-target-blank": "error",
        "jsx-no-undef": "error",
        "jsx-no-useless-fragment": "error",
        "jsx-pascal-case": "error",
        "jsx-props-no-spread-multi": "error",
        "jsx-props-no-spreading": "off",
        "no-array-index-key": "error",
        "no-children-prop": "error",
        "no-clone-element": "off",
        "no-danger": "error",
        "no-danger-with-children": "error",
        "no-did-mount-set-state": "off",
        "no-did-update-set-state": "error",
        "no-direct-mutation-state": "error",
        "no-find-dom-node": "error",
        "no-is-mounted": "error",
        "no-multi-comp": "off",
        "no-namespace": "error",
        "no-object-type-as-default-prop": "off",
        "no-react-children": "off",
        "no-redundant-should-component-update": "error",
        "no-render-return-value": "error",
        "no-set-state": "off",
        "no-string-refs": "error",
        "no-this-in-sfc": "error",
        "no-unescaped-entities": "error",
        "no-unknown-property": "error",
        "no-unsafe": ["error", { "checkAliases": true }],
        "no-unstable-nested-components": "error",
        "no-will-update-set-state": "error",
        "only-export-components": ["error", { "allowConstantExport": true }],
        "prefer-es6-class": ["error", "always"],
        "prefer-function-component": "off",
        "react-in-jsx-scope": "off",
        "require-render-return": "error",
        "rules-of-hooks": "error",
        "self-closing-comp": "error",
        "state-in-constructor": ["error", "never"],
        "style-prop-object": "error",
        "void-dom-elements-no-children": "error",
      },
    },
  ],
}
