{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["promise"],
  "rules": {
    "always-return": "error",
    "avoid-new": "error",
    "catch-or-return": "error",
    "no-callback-in-promise": "error",
    "no-multiple-resolved": "off",
    "no-nesting": "error",
    "no-new-statics": "error",
    "no-promise-in-callback": "error",
    "no-return-in-finally": "error",
    "no-return-wrap": "error",
    "param-names": "error",
    "prefer-await-to-callbacks": "off",
    "prefer-await-to-then": "off",
    "prefer-catch": "off",
    "spec-only": "off",
    "valid-params": "error",
  },
}
