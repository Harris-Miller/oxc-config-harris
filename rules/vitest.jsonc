{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "env": {
        "vitest": true,
      },
      "files": ["**/*.test.*", "**/*spec.*"],
      "plugins": ["vitest"],
      "rules": {
        "consistent-each-for": "off",
        "consistent-test-filename": "off",
        "consistent-test-it": "off",
        "consistent-vitest-vi": "off",
        "expect-expect": "error",
        "hoisted-apis-on-top": "off",
        "max-expects": "off",
        "max-nested-describe": "off",
        "no-alias-methods": "off",
        "no-commented-out-tests": "error",
        "no-conditional-expect": "error",
        "no-conditional-in-test": "off",
        "no-conditional-tests": "off",
        "no-disabled-tests": "error",
        "no-duplicate-hooks": "off",
        "no-focused-tests": "error",
        "no-hooks": "off",
        "no-identical-title": "error",
        "no-import-node-test": "error",
        "no-importing-vitest-globals": "off",
        "no-interpolation-in-snapshots": "error",
        "no-large-snapshots": "off",
        "no-mocks-import": "error",
        "no-restricted-matchers": "off",
        "no-restricted-vi-methods": "off",
        "no-standalone-expect": "error",
        "no-test-prefixes": "off",
        "no-test-return-statement": "off",
        "no-unneeded-async-expect-function": "error",
        "padding-around-after-all-blocks": "off",
        "prefer-called-exactly-once-with": "error",
        "prefer-called-once": "off",
        "prefer-called-times": "off",
        "prefer-called-with": "off",
        "prefer-comparison-matcher": "off",
        "prefer-describe-function-title": "off",
        "prefer-each": "off",
        "prefer-equality-matcher": "off",
        "prefer-expect-assertions": "off",
        "prefer-expect-resolves": "off",
        "prefer-expect-type-of": "off",
        "prefer-hooks-in-order": "off",
        "prefer-hooks-on-top": "off",
        "prefer-import-in-mock": "off",
        "prefer-importing-vitest-globals": "off",
        "prefer-lowercase-title": "off",
        "prefer-mock-promise-shorthand": "off",
        "prefer-mock-return-shorthand": "off",
        "prefer-snapshot-hint": "off",
        "prefer-spy-on": "off",
        "prefer-strict-boolean-matchers": "off",
        "prefer-strict-equal": "off",
        "prefer-to-be": "off",
        "prefer-to-be-falsy": "off",
        "prefer-to-be-object": "off",
        "prefer-to-be-truthy": "off",
        "prefer-to-contain": "off",
        "prefer-to-have-been-called-times": "off",
        "prefer-to-have-length": "off",
        "prefer-todo": "off",
        "require-awaited-expect-poll": "off",
        "require-hook": "off",
        "require-local-test-context-for-concurrent-snapshots": "error",
        "require-mock-type-parameters": "off",
        "require-test-timeout": "off",
        "require-to-throw-message": "off",
        "require-top-level-describe": "off",
        "valid-describe-callback": "error",
        "valid-expect": "error",
        "valid-expect-in-promise": "error",
        "valid-title": "error",
        "warn-todo": "off",
      },
    },
  ],
}
